@startuml
title Amphora — Component Architecture
skinparam backgroundColor white
skinparam componentStyle rectangle

package "Client" {
    [S3 / HTTP client] as Ext
}

package "Gateway Pod (stateless, scales horizontally)" {
    [cmd/app/main.go\nHTTP server, backend selection,\nhealth probe] as Main
    [internal/handler\n/object, /health] as Handler
    [pkg/storage_service.go\nobject key generation,\norchestration, capabilities] as Service
    [pkg/types.go\nStorageBackend (streaming Retrieve),\nObjectKey, Metadata] as Types
}

package "Storage Backends (pkg/)" {
    [local_fs_backend.go\n"local" — filesystem + JSON index] as Local
    [database_backend.go\n"hybrid" — filesystem + Postgres + Redis] as Hybrid
    [minio_backend.go\n"minio" — MinIO/S3 bytes + Postgres\n(default)] as Minio
}

package "Data Layer" {
    database "PostgreSQL\nmetadata index" as PG
    database "Redis\nmetadata cache" as Redis
    database "MinIO\n(distributed StatefulSet)" as MinioS3
    storage "Local filesystem\nobject bytes" as FS
}

package "Operational" {
    [goose migrations\n(migrations/)] as Migrations
    [reconcile.go / backfill.go\nReconcile CronJob (daily)] as Reconcile
    [deploy/helm/olympus\nHelm chart] as Helm
}

Ext --> Handler : PUT/GET /object/{bucket}/{key}
Handler --> Main
Handler --> Service
Service ..> Types : uses
Service --> Local
Service --> Hybrid
Service --> Minio

Local --> FS : StoreStream / Retrieve
Hybrid --> PG : metadata index
Hybrid --> Redis : cache
Hybrid --> FS : object bytes
Minio --> PG : metadata index
Minio --> MinioS3 : object bytes

Reconcile --> PG
Reconcile --> MinioS3
Migrations --> PG : goose (auto at startup)
Helm --> MinioS3 : deploys
Helm --> Reconcile : schedules

@enduml